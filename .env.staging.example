# =====================================================
# MedOrbit — Azure VM Staging Environment Configuration
#
# Copy this file to the project root as .env.staging and fill in real
# values. Read by docker-compose.staging.yml (env_file: .env.staging for
# both backend and ai-service; docker compose also reads it directly for
# ${VAR} interpolation when passed via --env-file).
#
# NEVER commit the real .env.staging file — it is gitignored on purpose.
# Placeholders below are marked CHANGE_ME. Do not reuse your local dev
# .env secrets here; generate fresh ones for staging.
# =====================================================

# Application
PORT=3001
NODE_ENV=production
# Caddy is the single trusted proxy hop. Required so authentication rate
# limits use the visitor address instead of Caddy's Docker-network address.
TRUST_PROXY=true

# Database
# DB_HOST is overridden to "postgres" by docker-compose.staging.yml's
# `environment:` block for both backend and ai-service — you don't need to
# set it here, but it's listed for completeness / non-Docker reference.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=medorbit
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=medorbit

# JWT — generate a fresh, strong secret for staging (do not reuse local dev).
# e.g. openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Public TLS hostname. It must have DNS A/AAAA records pointing to the VM
# before the `tls` profile starts, so Caddy can obtain its certificate.
MEDORBIT_PUBLIC_HOST=staging.example.com

# CORS — list the exact HTTPS browser origin served by Caddy.
CORS_ORIGIN=https://staging.example.com

# Google Sign-In (Google Identity Services client ID — NOT a client secret)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# AI Service
# Overridden to http://ai-service:8001 by docker-compose.staging.yml for
# container-to-container calls — listed here for non-Docker reference only.
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_MS=90000

# Email (Gmail SMTP) — required for OTP/verification emails to work on staging.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=CHANGE_ME@gmail.com
EMAIL_PASS=CHANGE_ME_gmail_app_password
EMAIL_FROM=CHANGE_ME@gmail.com

# Frontend URL — the END USER's browser follows this in email links, so it
# must be the VM's public origin, not a container-internal name.
FRONTEND_URL=https://staging.example.com/public

# Reference-only: the backend's own public origin, for use by deploy/health
# scripts and documentation. Not read by application code.
BACKEND_PUBLIC_URL=https://staging.example.com

# Ollama — staging does NOT run Ollama (see docker-compose.staging.yml
# comments). Left set so ai-service doesn't crash on a missing var; calls to
# it will simply fail/timeout, and AI-chat-dependent endpoints are expected
# to be unavailable on staging until a later phase.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen2:7b

# Per-user burst limit for authenticated drug-interaction checks. This is
# independent of the chatbot subscription quota.
# AI_DRUG_INTERACTIONS_PER_MINUTE=30
