# =====================================================
# MedOrbit — Root Environment Configuration
# Copy this file to the project root as .env and edit.
# This is the SINGLE .env read by backend, ai-service, and docker-compose.yml.
# =====================================================

# Application
PORT=3001
NODE_ENV=development

# Database
# DB_HOST: "localhost" when running backend/ai-service directly on the host
#          (as in npm run dev / uvicorn). Under `docker compose up`, the
#          backend and ai-service services override this to "postgres" (the
#          compose service name) — see docker-compose.yml's `environment:`
#          blocks. You do not need to change this value yourself for Docker.
DB_HOST=localhost
# Host-side tools and development processes use Docker PostgreSQL's dedicated
# loopback binding. Compose services override this to the container port 5432.
DB_PORT=5433
DB_NAME=medorbit
DB_USER=postgres
DB_PASSWORD=user123
DB_SCHEMA=medorbit

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# CORS — this is what the BROWSER sees the frontend as, so it stays
# localhost:8080 whether the stack runs on the host or under Docker (the
# frontend's published port is the same either way).
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Scheduling — preserves the current web/mobile 21-day booking window.
BOOKING_HORIZON_DAYS=21
SCHEDULING_TIMEZONE=Africa/Cairo

# Google Sign-In (Google Identity Services client ID — NOT a client secret)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Service
# AI_SERVICE_URL: "localhost:8001" on the host; under Docker, the backend
# service overrides this to "http://ai-service:8001" (compose service name).
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=90000

# Email (Gmail SMTP)
# Use a Gmail App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Frontend URL (for email verification and password reset links — this is a
# link the END USER clicks in their browser, so it stays localhost:8080 under
# Docker too, not a container-internal name)
FRONTEND_URL=http://localhost:8080/public

# Kafka is optional for the HTTP process. Dedicated Docker workers enable it
# after the S7 database migration is applied.
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=medorbit
KAFKA_OUTBOX_TOPIC=medorbit.domain-events.v1
KAFKA_CONSUMER_GROUP=medorbit-event-observer-v1
KAFKA_RECOMMENDATION_CONSUMER_GROUP=recommendation-profile-v1
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=8

# Ollama
# OLLAMA_URL: "localhost:11434" on the host. Ollama is NOT containerized (see
# DOCKER.md) — it's expected to already be running on the HOST machine.
# Under Docker, the ai-service service overrides this to
# "http://host.docker.internal:11434/api/generate" so the container can reach
# out to the host. You do not need to change this value yourself for Docker.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:7b

# ---------------------------------------------------------------------------
# Billing (Phase 2 — simulated provider)
# ---------------------------------------------------------------------------
# No real payment provider is connected yet, and no card data is collected
# anywhere in MedOrbit. Leave all three of these unset for a normal run: with
# no provider configured, checkout answers 503 and nothing can grant Pro.
#
# The two switches below belong to the local sandbox overlay
# (docker-compose.billing-sandbox.yml), which sets them itself — you do not
# normally put them in this file. Both are required together, and a process
# started with NODE_ENV=production refuses to boot if either is present, so
# nothing here can turn simulated payments on in a deployed environment.
# BILLING_PROVIDER=mock
# BILLING_MOCK_ENABLED=true

# The sandbox signs the provider events it simulates and verifies them again
# on the way in, so this is a real signing key even though the payments are
# not real. It has no default: set your own local value (16+ characters) to
# run the billing sandbox. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse a value published anywhere, including the placeholder below.
BILLING_MOCK_WEBHOOK_SECRET=replace_with_a_long_random_local_value

# Per-minute fair-use ceiling on chatbot messages. Separate mechanism from the
# free daily quota; only set this if you need to override the default.
# BILLING_FAIR_USE_CHAT_PER_MINUTE=20
