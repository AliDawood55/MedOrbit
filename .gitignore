#################################################
# ai-service/data — one-off data-collection scripts
# and diagnostic output, not needed to run the app.
# Kept tracked on purpose: osm_collector.py, save_to_db.py,
# osm_transform.py, nablus_review_export.py,
# build_nablus_seed.py, nablus_osm_review.csv
#################################################

ai-service/data/dry_run_*.py
ai-service/data/build_*_cleanup.py
ai-service/data/find_name_bug_victims.py
ai-service/data/fix_name_bug.py
ai-service/data/nudge_check.py
ai-service/data/wide*_export*.py
ai-service/data/_dry_run_*.sql
ai-service/data/wide_dry_run_out.txt
ai-service/data/nablus_wide_review*.csv
ai-service/data/cache/
ai-service/data/reports/

# Source PDFs for ai-service/rag/ingest_book.py (e.g. medical textbooks) —
# supplied locally via --pdf, not committed (copyrighted, and large).
ai-service/data/*.pdf

#################################################
# ai-service/virtual_doctor — generated / downloaded artifacts
# (merged from the nested .gitignore files formerly at
# ai-service/virtual_doctor/assets/tts_voices/.gitignore and
# ai-service/virtual_doctor/generated/.gitignore)
#################################################

# Piper TTS voices are downloaded on first use (~60MB each)
ai-service/virtual_doctor/assets/tts_voices/**/*.onnx
ai-service/virtual_doctor/assets/tts_voices/**/*.onnx.json

# Virtual Doctor generated output (reports, synthesized audio, etc.)
ai-service/virtual_doctor/generated/**

