<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces a blanket android:usesCleartextTraffic true setting, which allowed plain
  HTTP to any host in every build type, including release.

  Release builds default to TLS only. Local HTTP is permitted only by the
  debug resource overlay; a release build cannot silently downgrade traffic.

  Production builds are expected to supply an HTTPS origin using Dart define
  values MEDORBIT_API_URL and are covered by base-config below. Do not add a
  public hostname here, because that would silently downgrade real patient
  traffic to plaintext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

</network-security-config>
