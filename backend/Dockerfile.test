FROM node:20-bullseye-slim

WORKDIR /app

# Root context: root package.json/package-lock.json carry the npm workspace
# definition, backend/package.json is the workspace member being installed.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
# -w backend scopes the install to the backend workspace (root-only deps and
# root devDependencies excluded); no --omit=dev here since tests need
# backend's own devDependencies (nodemon, pino-pretty, socket.io-client).
RUN npm ci -w backend

COPY backend/ ./backend/
# A small number of contract tests assert that retired client-only video/call
# paths are absent. Keep the source available to the dedicated test image;
# this image is test-only and is never used as a production frontend image.
COPY frontend/ ./frontend/

WORKDIR /app/backend

EXPOSE 3001

CMD ["node", "server.js"]
