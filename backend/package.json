    "test:s1c": "node tests/s1c-admin-foundation.test.js",
    "test:s2": "node tests/s2-doctor-lifecycle.test.js",
    "test:s3": "node tests/s3-care-relationships.test.js",
    "test:s4": "node tests/s4-social-feed.test.js",
    "test:s5": "node tests/s5-direct-messaging.test.js",
    "test:s7": "node tests/s7-event-foundation.test.js",
    "test:s8": "node tests/s8-deterministic-recommendations.test.js",
    "test:s8.5": "node tests/s8-5-ml-readiness.test.js",
    "test:s8.6": "node tests/s8-6-signal-activation.test.js",
    "test:admin-rate-notifications": "node tests/admin-rate-notifications.test.js",
    "test:user-content": "node tests/user-content-unification.test.js",
    "test:profile-communication-ux": "node tests/profile-communication-ux.test.js",
    "test:doctor-scheduling": "node tests/doctor-self-service-scheduling.test.js",
    "test:analytics": "node tests/analytics.test.js",
    "test:auth-gate": "node tests/global-auth-gate.test.js",
    "test:billing": "node tests/billing-entitlements.test.js",
    "worker:outbox": "node scripts/outbox-worker.js",
    "worker:events": "node scripts/event-consumer.js",
    "worker:recommendations": "node scripts/recommendation-consumer.js",
    "recommendations:rebuild": "node scripts/rebuild-user-interests.js",
